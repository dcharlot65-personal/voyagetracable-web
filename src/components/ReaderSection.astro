---
// "The Reader" — the shared section that points to read.davidjcharlot.com.
// The copy is canonical (logs/cm/qc/reader-copy.md) and is used word for word
// on every site; change the styling here, never the words.
// On this site it sits inside the Ventures section, under the venture cards,
// as one more piece of the company's work (so its heading is an h3).
---

<!-- The Reader -->
<div id="reader" data-reveal class="glass-card mt-8 p-8 md:p-10">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 md:gap-12">
    <div class="max-w-3xl">
      <div class="w-14 h-14 mb-5 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center">
        <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.331 0 4.471.89 6.07 2.35.1.08.2.15.31.21a.75.75 0 00.69-.01c.1-.06.2-.13.3-.21A8.968 8.968 0 0118 18c1.052 0 2.062.18 3 .512V4.262A8.958 8.958 0 0018 3.75a8.967 8.967 0 00-6 2.292z" />
        </svg>
      </div>
      <p class="section-label mb-3">// Free to read · Free to hear</p>
      <h3 class="font-display text-2xl md:text-3xl font-bold text-white mb-4 leading-tight">
        Every book, open to <span class="gradient-violet">everyone</span>
      </h3>
      <p class="text-brand-slate leading-relaxed">
        The books of David Jean Charlot, PhD, are free to read in your browser as
        pre-release editions: more than two hundred of them so far, with no account
        needed. Press <strong class="font-semibold text-brand-light">Listen</strong> and a
        natural voice reads the chapter to you. It is one goal, simple to say and long
        to finish: to share reading with the world.
      </p>
    </div>

    <div class="shrink-0">
      <a href="https://read.davidjcharlot.com/" class="btn-primary">
        Open the reader
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</div>
